# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (Google Cloud SQL or local PostgreSQL).
# Configured for Cloud SQL project / instance: gen-lang-client-0440360642
# If not connected or proxy is not running, Café Companion automatically runs with in-memory store.
# Cloud SQL Socket format: postgresql://postgres:password@/cafe_companion?host=/cloudsql/gen-lang-client-0440360642
# Cloud SQL Proxy format:  postgresql://postgres:password@127.0.0.1:5432/cafe_companion
DATABASE_URL="postgresql://postgres:password@localhost:5432/cafe_companion?host=/cloudsql/gen-lang-client-0440360642"

# VITE_USE_MOCK_API: Optional frontend switch to run purely in mock mode without backend calls.
VITE_USE_MOCK_API="false"

# PORT: Server port (defaults to 3000).
PORT=3000
